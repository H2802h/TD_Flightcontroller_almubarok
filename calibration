// Fungsi untuk menyimpan kalibrasi ke EEPROM
void saveCalibration() {
  EEPROM.put(EEPROM_ACCEL_OFFSET_X, cal_data.accel_offset_x);
  EEPROM.put(EEPROM_ACCEL_OFFSET_Y, cal_data.accel_offset_y);
  EEPROM.put(EEPROM_ACCEL_OFFSET_Z, cal_data.accel_offset_z);
  EEPROM.put(EEPROM_GYRO_OFFSET_X, cal_data.gyro_offset_x);
  EEPROM.put(EEPROM_GYRO_OFFSET_Y, cal_data.gyro_offset_y);
  EEPROM.put(EEPROM_GYRO_OFFSET_Z, cal_data.gyro_offset_z);
  EEPROM.put(EEPROM_MAG_OFFSET_X, cal_data.mag_offset_x);
  EEPROM.put(EEPROM_MAG_OFFSET_Y, cal_data.mag_offset_y);
  EEPROM.put(EEPROM_MAG_OFFSET_Z, cal_data.mag_offset_z);
  EEPROM.put(EEPROM_MAG_SCALE_X, cal_data.mag_scale_x);
  EEPROM.put(EEPROM_MAG_SCALE_Y, cal_data.mag_scale_y);
  EEPROM.put(EEPROM_MAG_SCALE_Z, cal_data.mag_scale_z);
  EEPROM.write(EEPROM_CALIBRATED_FLAG, 1);
  
  cal_data.is_calibrated = true;
  
  Serial.println("Data kalibrasi disimpan ke EEPROM.");
}

// Fungsi untuk memuat kalibrasi dari EEPROM
void loadCalibration() {
  if(EEPROM.read(EEPROM_CALIBRATED_FLAG) == 1) {
    EEPROM.get(EEPROM_ACCEL_OFFSET_X, cal_data.accel_offset_x);
    EEPROM.get(EEPROM_ACCEL_OFFSET_Y, cal_data.accel_offset_y);
    EEPROM.get(EEPROM_ACCEL_OFFSET_Z, cal_data.accel_offset_z);
    EEPROM.get(EEPROM_GYRO_OFFSET_X, cal_data.gyro_offset_x);
    EEPROM.get(EEPROM_GYRO_OFFSET_Y, cal_data.gyro_offset_y);
    EEPROM.get(EEPROM_GYRO_OFFSET_Z, cal_data.gyro_offset_z);
    EEPROM.get(EEPROM_MAG_OFFSET_X, cal_data.mag_offset_x);
    EEPROM.get(EEPROM_MAG_OFFSET_Y, cal_data.mag_offset_y);
    EEPROM.get(EEPROM_MAG_OFFSET_Z, cal_data.mag_offset_z);
    EEPROM.get(EEPROM_MAG_SCALE_X, cal_data.mag_scale_x);
    EEPROM.get(EEPROM_MAG_SCALE_Y, cal_data.mag_scale_y);
    EEPROM.get(EEPROM_MAG_SCALE_Z, cal_data.mag_scale_z);
    
    cal_data.is_calibrated = true;
    Serial.println("Data kalibrasi dimuat dari EEPROM.");
  } else {
    // Set default values
    cal_data.accel_offset_x = 0;
    cal_data.accel_offset_y = 0;
    cal_data.accel_offset_z = 0;
    cal_data.gyro_offset_x = 0;
    cal_data.gyro_offset_y = 0;
    cal_data.gyro_offset_z = 0;
    cal_data.mag_offset_x = 0;
    cal_data.mag_offset_y = 0;
    cal_data.mag_offset_z = 0;
    cal_data.mag_scale_x = 1.0;
    cal_data.mag_scale_y = 1.0;
    cal_data.mag_scale_z = 1.0;
    cal_data.is_calibrated = false;
    
    Serial.println("Tidak ada data kalibrasi. Gunakan nilai default.");
  }
}

// Fungsi pembacaan sensor
void readAccelerometer(int16_t* x, int16_t* y, int16_t* z) {
  Wire.beginTransmission(MPU9250_ADDRESS);
  Wire.write(ACCEL_XOUT_H);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU9250_ADDRESS, 6);
  
  *x = (Wire.read() << 8) | Wire.read();
  *y = (Wire.read() << 8) | Wire.read();
  *z = (Wire.read() << 8) | Wire.read();
}

void readGyroscope(int16_t* x, int16_t* y, int16_t* z) {
  Wire.beginTransmission(MPU9250_ADDRESS);
  Wire.write(GYRO_XOUT_H);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU9250_ADDRESS, 6);
  
  *x = (Wire.read() << 8) | Wire.read();
  *y = (Wire.read() << 8) | Wire.read();
  *z = (Wire.read() << 8) | Wire.read();
}

bool readMagnetometer(int16_t* x, int16_t* y, int16_t* z) {
  Wire.beginTransmission(AK8963_ADDRESS);
  Wire.write(MAG_XOUT_L);
  Wire.endTransmission(false);
  Wire.requestFrom(AK8963_ADDRESS, 7);
  
  if(Wire.available() < 7) return false;
  
  *x = Wire.read() | (Wire.read() << 8);
  *y = Wire.read() | (Wire.read() << 8);
  *z = Wire.read() | (Wire.read() << 8);
  Wire.read(); // ST2 register
  
  return true;
}

// Fungsi inisialisasi
bool initMPU9250() {
  uint8_t whoami = readByte(MPU9250_ADDRESS, WHO_AM_I);
  if (whoami != 0x71) return false;
  
  writeByte(MPU9250_ADDRESS, PWR_MGMT_1, 0x80);
  delay(100);
  writeByte(MPU9250_ADDRESS, PWR_MGMT_1, 0x01);
  delay(100);
  writeByte(MPU9250_ADDRESS, ACCEL_CONFIG, 0x00);
  writeByte(MPU9250_ADDRESS, GYRO_CONFIG, 0x00);
  writeByte(MPU9250_ADDRESS, SMPLRT_DIV, 0x09);
  writeByte(MPU9250_ADDRESS, CONFIG, 0x03);
  writeByte(MPU9250_ADDRESS, ACCEL_CONFIG2, 0x03);
  writeByte(MPU9250_ADDRESS, INT_PIN_CFG, 0x02);
  delay(100);
  
  return true;
}

bool initMagnetometer() {
  uint8_t whoami = readByte(AK8963_ADDRESS, 0x00);
  if (whoami != 0x48) return false;
  
  writeByte(AK8963_ADDRESS, MAG_CNTL2, 0x01);
  delay(100);
  writeByte(AK8963_ADDRESS, MAG_CNTL1, 0x16);
  delay(100);
  
  return true;
}

// Helper functions untuk I2C
void writeByte(uint8_t address, uint8_t reg, uint8_t data) {
  Wire.beginTransmission(address);
  Wire.write(reg);
  Wire.write(data);
  Wire.endTransmission();
}

uint8_t readByte(uint8_t address, uint8_t reg) {
  Wire.beginTransmission(address);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(address, (uint8_t)1);
  return Wire.read();
}
