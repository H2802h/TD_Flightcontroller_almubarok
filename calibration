
#include <Wire.h>
#include <EEPROM.h>

// MPU9250 I2C addresses
#define MPU9250_ADDRESS 0x68
#define AK8963_ADDRESS  0x0C

// Register addresses
#define PWR_MGMT_1      0x6B
#define PWR_MGMT_2      0x6C
#define CONFIG          0x1A
#define GYRO_CONFIG     0x1B
#define ACCEL_CONFIG    0x1C
#define ACCEL_CONFIG2   0x1D
#define SMPLRT_DIV      0x19
#define INT_PIN_CFG     0x37
#define WHO_AM_I        0x75

// Data registers
#define ACCEL_XOUT_H    0x3B
#define GYRO_XOUT_H     0x43
#define MAG_XOUT_L      0x03
#define MAG_CNTL1       0x0A
#define MAG_CNTL2       0x0B

// EEPROM addresses untuk menyimpan kalibrasi
#define EEPROM_ACCEL_OFFSET_X   0
#define EEPROM_ACCEL_OFFSET_Y   4
#define EEPROM_ACCEL_OFFSET_Z   8
#define EEPROM_GYRO_OFFSET_X    12
#define EEPROM_GYRO_OFFSET_Y    16
#define EEPROM_GYRO_OFFSET_Z    20
#define EEPROM_MAG_OFFSET_X     24
#define EEPROM_MAG_OFFSET_Y     28
#define EEPROM_MAG_OFFSET_Z     32
#define EEPROM_MAG_SCALE_X      36
#define EEPROM_MAG_SCALE_Y      40
#define EEPROM_MAG_SCALE_Z      44
#define EEPROM_CALIBRATED_FLAG  48

// Struktur untuk menyimpan offset kalibrasi
struct CalibrationData {
  // Offset accelerometer
  float accel_offset_x, accel_offset_y, accel_offset_z;
  
  // Offset gyroscope
  float gyro_offset_x, gyro_offset_y, gyro_offset_z;
  
  // Offset dan scale magnetometer
  float mag_offset_x, mag_offset_y, mag_offset_z;
  float mag_scale_x, mag_scale_y, mag_scale_z;
  
  bool is_calibrated;
};

CalibrationData cal_data;

// Scaling factors
float accel_scale = 2.0 / 32768.0;  // ±2g
float gyro_scale = 250.0 / 32768.0; // ±250°/s
float mag_scale = 4912.0 / 32768.0; // ±4912 μT

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);
  
  delay(1000);
  Serial.println("=== PROGRAM KALIBRASI MPU9250 ===");
  Serial.println();
  
  // Initialize MPU9250
  if (!initMPU9250()) {
    Serial.println("Gagal menginisialisasi MPU9250!");
    while(1);
  }
  
  if (!initMagnetometer()) {
    Serial.println("Gagal menginisialisasi magnetometer!");
  }
  
  // Load kalibrasi dari EEPROM
  loadCalibration();
  
  showMenu();
}

void loop() {
  if (Serial.available()) {
    char command = Serial.read();
    
    switch(command) {
      case '1':
        calibrateAccelerometer();
        break;
      case '2':
        calibrateGyroscope();
        break;
      case '3':
        calibrateMagnetometer();
        break;
      case '4':
        fullCalibration();
        break;
      case '5':
        testCalibratedData();
        break;
      case '6':
        resetCalibration();
        break;
      case '7':
        showCalibrationData();
        break;
      case 'm':
      case 'M':
        showMenu();
        break;
      default:
        Serial.println("Perintah tidak dikenal. Ketik 'm' untuk menu.");
    }
  }
}

void showMenu() {
  Serial.println("\n=== MENU KALIBRASI ===");
  Serial.println("1. Kalibrasi Accelerometer");
  Serial.println("2. Kalibrasi Gyroscope");
  Serial.println("3. Kalibrasi Magnetometer");
  Serial.println("4. Kalibrasi Lengkap (Semua)");
  Serial.println("5. Test Data Terkalibrasi");
  Serial.println("6. Reset Kalibrasi");
  Serial.println("7. Tampilkan Data Kalibrasi");
  Serial.println("m. Tampilkan Menu");
  Serial.println("\nPilih opsi (1-7 atau m): ");
}

void calibrateAccelerometer() {
  Serial.println("\n=== KALIBRASI ACCELEROMETER ===");
  Serial.println();
  Serial.println("INSTRUKSI KALIBRASI ACCELEROMETER:");
  Serial.println("1. Letakkan sensor pada permukaan DATAR dan STABIL");
  Serial.println("2. Pastikan sumbu Z mengarah ke ATAS (melawan gravitasi)");
  Serial.println("3. Jangan sentuh atau gerakkan sensor selama kalibrasi");
  Serial.println("4. Kalibrasi akan mengambil 1000 sampel data");
  Serial.println();
  Serial.println("Tekan ENTER untuk memulai kalibrasi...");
  
  while(Serial.read() != '\n' && Serial.available() == 0);
  while(Serial.read() != '\n');
  
  Serial.println("Memulai kalibrasi accelerometer...");
  
  long sum_x = 0, sum_y = 0, sum_z = 0;
  int samples = 1000;
  
  for(int i = 0; i < samples; i++) {
    int16_t ax, ay, az;
    readAccelerometer(&ax, &ay, &az);
    
    sum_x += ax;
    sum_y += ay;
    sum_z += az;
    
    if(i % 100 == 0) {
      Serial.print("Progress: ");
      Serial.print((i * 100) / samples);
      Serial.println("%");
    }
    
    delay(2);
  }
  
  // Hitung offset (untuk Z, offset = raw_value - 1g dalam raw format)
  cal_data.accel_offset_x = -(float)sum_x / samples;
  cal_data.accel_offset_y = -(float)sum_y / samples;
  cal_data.accel_offset_z = -(float)sum_z / samples + (1.0 / accel_scale); // +1g untuk Z
  
  Serial.println("Kalibrasi accelerometer selesai!");
  Serial.println("Offset yang dihitung:");
  Serial.print("X: "); Serial.println(cal_data.accel_offset_x * accel_scale, 4);
  Serial.print("Y: "); Serial.println(cal_data.accel_offset_y * accel_scale, 4);
  Serial.print("Z: "); Serial.println(cal_data.accel_offset_z * accel_scale, 4);
  
  saveCalibration();
}

