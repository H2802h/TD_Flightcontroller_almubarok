void calibrateMagnetometer() {
  Serial.println("\n=== KALIBRASI MAGNETOMETER ===");
  Serial.println();
  Serial.println("INSTRUKSI KALIBRASI MAGNETOMETER:");
  Serial.println("1. Kalibrasi ini membutuhkan GERAKAN KHUSUS");
  Serial.println("2. Anda akan diminta memutar sensor ke SEMUA ARAH");
  Serial.println("3. Lakukan gerakan FIGURE-8 (angka 8) di udara");
  Serial.println("4. Putar sensor PERLAHAN ke segala arah selama 30 detik");
  Serial.println("5. Pastikan semua sumbu (X,Y,Z) mengalami rotasi penuh");
  Serial.println("6. Hindari benda logam atau magnet di sekitar");
  Serial.println();
  Serial.println("Tekan ENTER untuk memulai kalibrasi...");
  
  while(Serial.read() != '\n' && Serial.available() == 0);
  while(Serial.read() != '\n');
  
  Serial.println("Memulai kalibrasi magnetometer...");
  Serial.println("MULAI MEMUTAR SENSOR SEKARANG!");
  
  int16_t mag_max[3] = {-32767, -32767, -32767};
  int16_t mag_min[3] = {32767, 32767, 32767};
  
  unsigned long start_time = millis();
  int samples = 0;
  
  while(millis() - start_time < 30000) { // 30 detik
    int16_t mx, my, mz;
    if(readMagnetometer(&mx, &my, &mz)) {
      // Update min/max values
      if(mx > mag_max[0]) mag_max[0] = mx;
      if(mx < mag_min[0]) mag_min[0] = mx;
      if(my > mag_max[1]) mag_max[1] = my;
      if(my < mag_min[1]) mag_min[1] = my;
      if(mz > mag_max[2]) mag_max[2] = mz;
      if(mz < mag_min[2]) mag_min[2] = mz;
      
      samples++;
      
      // Progress indicator
      if(samples % 50 == 0) {
        int progress = ((millis() - start_time) * 100) / 30000;
        Serial.print("Progress: ");
        Serial.print(progress);
        Serial.print("% - Sampel: ");
        Serial.println(samples);
      }
    }
    delay(20);
  }
  
  Serial.println("STOP! Kalibrasi magnetometer selesai!");
  
  // Hitung offset (hard iron correction)
  cal_data.mag_offset_x = (mag_max[0] + mag_min[0]) / 2.0;
  cal_data.mag_offset_y = (mag_max[1] + mag_min[1]) / 2.0;
  cal_data.mag_offset_z = (mag_max[2] + mag_min[2]) / 2.0;
  
  // Hitung scale (soft iron correction)
  float range_x = mag_max[0] - mag_min[0];
  float range_y = mag_max[1] - mag_min[1];
  float range_z = mag_max[2] - mag_min[2];
  float avg_range = (range_x + range_y + range_z) / 3.0;
  
  cal_data.mag_scale_x = avg_range / range_x;
  cal_data.mag_scale_y = avg_range / range_y;
  cal_data.mag_scale_z = avg_range / range_z;
  
  Serial.print("Sampel yang dikumpulkan: "); Serial.println(samples);
  Serial.println("Hasil kalibrasi magnetometer:");
  Serial.print("Offset X: "); Serial.println(cal_data.mag_offset_x);
  Serial.print("Offset Y: "); Serial.println(cal_data.mag_offset_y);
  Serial.print("Offset Z: "); Serial.println(cal_data.mag_offset_z);
  Serial.print("Scale X: "); Serial.println(cal_data.mag_scale_x, 4);
  Serial.print("Scale Y: "); Serial.println(cal_data.mag_scale_y, 4);
  Serial.print("Scale Z: "); Serial.println(cal_data.mag_scale_z, 4);
  
  saveCalibration();
}

void fullCalibration() {
  Serial.println("\n=== KALIBRASI LENGKAP ===");
  Serial.println("Akan melakukan kalibrasi semua sensor secara berurutan.");
  Serial.println("Ikuti instruksi untuk setiap sensor.");
  Serial.println();
  
  calibrateAccelerometer();
  delay(2000);
  
  calibrateGyroscope();
  delay(2000);
  
  calibrateMagnetometer();
  
  Serial.println("\n=== KALIBRASI LENGKAP SELESAI ===");
  Serial.println("Semua sensor telah dikalibrasi dan disimpan ke EEPROM.");
}

void testCalibratedData() {
  Serial.println("\n=== TEST DATA TERKALIBRASI ===");
  
  if(!cal_data.is_calibrated) {
    Serial.println("PERINGATAN: Sensor belum dikalibrasi!");
    Serial.println("Lakukan kalibrasi terlebih dahulu.");
    return;
  }
  
  Serial.println("Menampilkan data sensor terkalibrasi selama 10 detik...");
  Serial.println("Format: Raw | Kalibrasi");
  
  unsigned long start_time = millis();
  
  while(millis() - start_time < 10000) {
    // Read raw data
    int16_t ax, ay, az, gx, gy, gz, mx, my, mz;
    readAccelerometer(&ax, &ay, &az);
    readGyroscope(&gx, &gy, &gz);
    readMagnetometer(&mx, &my, &mz);
    
    // Apply calibration
    float cal_ax = (ax + cal_data.accel_offset_x) * accel_scale;
    float cal_ay = (ay + cal_data.accel_offset_y) * accel_scale;
    float cal_az = (az + cal_data.accel_offset_z) * accel_scale;
    
    float cal_gx = (gx + cal_data.gyro_offset_x) * gyro_scale;
    float cal_gy = (gy + cal_data.gyro_offset_y) * gyro_scale;
    float cal_gz = (gz + cal_data.gyro_offset_z) * gyro_scale;
    
    float cal_mx = (mx - cal_data.mag_offset_x) * cal_data.mag_scale_x * mag_scale;
    float cal_my = (my - cal_data.mag_offset_y) * cal_data.mag_scale_y * mag_scale;
    float cal_mz = (mz - cal_data.mag_offset_z) * cal_data.mag_scale_z * mag_scale;
    
    // Display data
    Serial.println("--- Accelerometer (g) ---");
    Serial.print("X: "); Serial.print(ax * accel_scale, 3); 
    Serial.print(" | "); Serial.println(cal_ax, 3);
    Serial.print("Y: "); Serial.print(ay * accel_scale, 3); 
    Serial.print(" | "); Serial.println(cal_ay, 3);
    Serial.print("Z: "); Serial.print(az * accel_scale, 3); 
    Serial.print(" | "); Serial.println(cal_az, 3);
    
    Serial.println("--- Gyroscope (°/s) ---");
    Serial.print("X: "); Serial.print(gx * gyro_scale, 3); 
    Serial.print(" | "); Serial.println(cal_gx, 3);
    Serial.print("Y: "); Serial.print(gy * gyro_scale, 3); 
    Serial.print(" | "); Serial.println(cal_gy, 3);
    Serial.print("Z: "); Serial.print(gz * gyro_scale, 3); 
    Serial.print(" | "); Serial.println(cal_gz, 3);
    
    Serial.println("--- Magnetometer (μT) ---");
    Serial.print("X: "); Serial.print(mx * mag_scale, 1); 
    Serial.print(" | "); Serial.println(cal_mx, 1);
    Serial.print("Y: "); Serial.print(my * mag_scale, 1); 
    Serial.print(" | "); Serial.println(cal_my, 1);
    Serial.print("Z: "); Serial.print(mz * mag_scale, 1); 
    Serial.print(" | "); Serial.println(cal_mz, 1);
    
    Serial.println("------------------------");
    delay(1000);
  }
}

void resetCalibration() {
  Serial.println("\n=== RESET KALIBRASI ===");
  Serial.println("Apakah Anda yakin ingin mereset semua data kalibrasi? (y/n)");
  
  while(!Serial.available());
  char response = Serial.read();
  
  if(response == 'y' || response == 'Y') {
    // Reset semua nilai kalibrasi
    cal_data.accel_offset_x = 0;
    cal_data.accel_offset_y = 0;
    cal_data.accel_offset_z = 0;
    cal_data.gyro_offset_x = 0;
    cal_data.gyro_offset_y = 0;
    cal_data.gyro_offset_z = 0;
    cal_data.mag_offset_x = 0;
    cal_data.mag_offset_y = 0;
    cal_data.mag_offset_z = 0;
    cal_data.mag_scale_x = 1.0;
    cal_data.mag_scale_y = 1.0;
    cal_data.mag_scale_z = 1.0;
    cal_data.is_calibrated = false;
    
    // Hapus dari EEPROM
    EEPROM.write(EEPROM_CALIBRATED_FLAG, 0);
    
    Serial.println("Data kalibrasi telah direset!");
  } else {
    Serial.println("Reset dibatalkan.");
  }
}

