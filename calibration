  Serial.print("Z: "); Serial.print(cal_data.gyro_offset_z * gyro_scale, 4); Serial.println(" °/s");
  
  Serial.println("\nMagnetometer Offset:");
  Serial.print("X: "); Serial.println(cal_data.mag_offset_x);
  Serial.print("Y: "); Serial.println(cal_data.mag_offset_y);
  Serial.print("Z: "); Serial.println(cal_data.mag_offset_z);
  
  Serial.println("\nMagnetometer Scale:");
  Serial.print("X: "); Serial.println(cal_data.mag_scale_x, 4);
